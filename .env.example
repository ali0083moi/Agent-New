# ---------- هوش مصنوعی (GapGPT — سازگار با OpenAI) ----------
GAPGPT_API_KEY=sk-...
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# مدل اصلی گفتگو و ابزارها (باید function calling داشته باشد). با `python -m app.evals` مقایسه کن.
CHAT_MODEL=gpt-4.1
# مدل سریع و ارزان برای پیام‌های پیگیری خودکار، خلاصه‌سازی و یادگیری
FAST_MODEL=gpt-4.1-mini
# مدل تصویر (خواندن عکس برنامه کلاسی، عکس رایتینگ)
VISION_MODEL=gpt-4.1
# مدل تصحیح آیلتس (خالی = همان CHAT_MODEL). مدل قوی‌تر = نمره دقیق‌تر، مثلاً claude-opus-5-5
IELTS_MODEL=
# اگر مدل اصلی جواب نداد، به ترتیب این‌ها امتحان می‌شوند
FALLBACK_MODELS=gpt-4o,gpt-4.1-mini
# ویس به متن (اولی ارزان‌تر)، و جایگزین
TRANSCRIBE_MODEL=gapgpt/whisper-1
TRANSCRIBE_FALLBACK_MODELS=whisper-1
# متن به ویس برای جواب صوتی
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova
# حافظه معنایی
EMBEDDING_MODEL=text-embedding-3-small
# اگر سرور به GapGPT دسترسی مستقیم ندارد (مثلاً سرور خارج از ایران)، از یک پروکسی داخل ایران رد شو:
LLM_PROXY=
# (اختیاری) قیمت مدل‌هایی که در جدول داخلی نیستند، دلار به ازای ۱ میلیون توکن ورودی/خروجی
# MODEL_PRICES={"my-model": [1.0, 4.0]}

# ---------- تلگرام ----------
# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=
# (اختیاری) اگر chat id خودت را می‌دانی، اینجا بگذار تا نیازی به کد اتصال نباشد
TELEGRAM_CHAT_ID=
# (اختیاری) اگر سرور به api.telegram.org دسترسی ندارد: پروکسی یا آدرس Bot API جایگزین
TELEGRAM_PROXY=
TELEGRAM_API_BASE=https://api.telegram.org

# ---------- نوتیفیکیشن مرورگر (PWA) ----------
VAPID_SUBJECT=mailto:you@example.com

# ---------- برنامه ----------
TIMEZONE=Asia/Tehran
# اگر روی سرور عمومی اجرا می‌کنی حتماً رمز بگذار
APP_PASSWORD=
SECRET_KEY=change-me-to-a-long-random-string
PORT=8000
