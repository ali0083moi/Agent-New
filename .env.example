# ---------- هوش مصنوعی (GapGPT — سازگار با OpenAI) ----------
GAPGPT_API_KEY=sk-...
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# مدل اصلی گفتگو (ابزارها/برنامه‌ریزی) — هر مدلی که GapGPT پشتیبانی می‌کند و function calling دارد
CHAT_MODEL=gpt-4.1
# مدل سریع و ارزان برای پیام‌های پیگیری خودکار
FAST_MODEL=gpt-4.1-mini
# مدل تصویر (خواندن عکس برنامه کلاسی)
VISION_MODEL=gpt-4.1
# مدل تبدیل ویس به متن
TRANSCRIBE_MODEL=whisper-1

# ---------- تلگرام ----------
# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=
# (اختیاری) اگر chat id خودت را می‌دانی، اینجا بگذار تا نیازی به کد اتصال نباشد
TELEGRAM_CHAT_ID=
# (اختیاری) اگر سرور به api.telegram.org دسترسی ندارد: پروکسی یا آدرس Bot API جایگزین
TELEGRAM_PROXY=
TELEGRAM_API_BASE=https://api.telegram.org

# ---------- برنامه ----------
TIMEZONE=Asia/Tehran
# اگر روی سرور عمومی اجرا می‌کنی حتماً رمز بگذار
APP_PASSWORD=
SECRET_KEY=change-me-to-a-long-random-string
PORT=8000
